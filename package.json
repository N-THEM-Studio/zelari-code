{
  "name": "zelari-code",
  "version": "2.63.0",
  "description": "Zelari Code — open-source coding orchestrator CLI. You choose the model; the proof is mandatory. Kraken by default, council when the work earns it: plan/build phases, provider-agnostic LLM streaming, self-update.",
  "author": "Anathema Studio <https://anathema-studio.com/>",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/cli/main.js",
  "bin": {
    "zelari-code": "bin/zelari-code.js"
  },
  "files": [
    "bin",
    "dist",
    "scripts/postinstall.mjs",
    "scripts/repair-path.mjs",
    "scripts/*.ps1",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20.17.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && npm run build --workspace=@zelari/core && tsc -p tsconfig.json && node scripts/bundle-cli.mjs",
    "build:cli": "npm run clean && npm run build --workspace=@zelari/core && tsc -p tsconfig.json && node scripts/bundle-cli.mjs",
    "typecheck": "npm run build --workspace=@zelari/core && tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build --workspace=@zelari/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:safety": "vitest run src/cli/safety packages/core/src/core/safety",
    "test:session": "vitest run packages/core/src/session src/cli/sessionSpine.test.ts src/cli/headlessSpine.test.ts src/cli/headlessHistorySeed.test.ts src/cli/headlessSessionEvent.test.ts src/cli/sessionReplayInvariant.test.ts src/cli/legacyContextIsolation.test.ts src/cli/kraken/verificationBridge.session.test.ts",
    "smoke": "node bin/zelari-code.js --version",
    "skills:check": "node bin/zelari-code.js skills:check",
    "smoke:acp": "node scripts/smoke-acp.mjs",
    "smoke:mission": "vitest run src/cli/headless/missionE2e.smoke.test.ts",
    "mission:metrics": "node scripts/mission-metrics.mjs",
    "verify:council": "npm run build --workspace=@zelari/core && node scripts/verify-council.mjs",
    "verify:principles": "node scripts/verify-principles.mjs",
    "verify:versions": "node scripts/verify-versions.mjs",
    "verify:plan-sync": "node scripts/verify-plan-sync.mjs",
    "tag-release": "node scripts/tag-release.mjs",
    "desktop:install": "npm install --prefix apps/desktop",
    "desktop:dev": "npm run build:cli && npm run tauri:dev --prefix apps/desktop",
    "companion:android": "cd apps/companion-android && .\\gradlew.bat assembleDebug",
    "vscode:build": "npm run build --prefix apps/vscode",
    "desktop:build": "npm run tauri:build --prefix apps/desktop",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "node scripts/prepublish.mjs",
    "eval:gate": "node --experimental-strip-types tools/eval/runGate.ts",
    "eval:extensions": "node --experimental-transform-types --disable-warning=ExperimentalWarning tools/eval/runExtensionsBaseline.ts",
    "eval:seed-baseline": "node --experimental-strip-types tools/eval/runSeedBaseline.ts",
    "eval:measured": "node --experimental-strip-types tools/eval/runMeasured.ts",
    "evidence:report": "node --experimental-strip-types tools/eval/runEvidenceReport.ts",
    "explore:gate": "node --experimental-strip-types tools/eval/runExploreFlipGate.ts",
    "evolve:propose": "node --experimental-strip-types tools/eval/runEvolvePropose.ts",
    "pattern:ledger": "node --experimental-strip-types tools/eval/runPatternLedger.ts",
    "evolve:decide": "node --experimental-strip-types tools/eval/runEvolveDecide.ts",
    "evolve:validate": "node --experimental-strip-types tools/eval/runEvolveValidate.ts",
    "evolve:seal": "node --experimental-strip-types tools/eval/runEvolveSeal.ts",
    "edit:bench": "node --experimental-strip-types tools/eval/runEditBench.ts",
    "bench:competitive": "node --experimental-strip-types tools/eval/runCompetitiveBench.ts",
    "test:eval": "vitest run tools/eval",
    "perf:bench": "node scripts/perf-bench.mjs",
    "dogfood:audit": "node scripts/dogfood-audit.mjs",
    "dogfood:brief": "node scripts/dogfood-brief.mjs",
    "dogfood:run": "node scripts/dogfood-driver.mjs",
    "test:memory": "vitest run packages/core/src/memory/scoring.test.ts tests/unit/core-agentHarness-memory.test.ts tests/unit/cli-sqliteMemoryV2.test.ts tests/unit/cli-memorySemantic.test.ts tests/unit/cli-memoryMigration.test.ts tests/unit/cli-memoryMcp.test.ts tests/unit/cli-memoryJsonApi.test.ts tests/unit/cli-memoryCommands.test.ts tests/unit/cli-memoryPerformance.test.ts tests/unit/cli-kraken-sharedMemory.test.ts tests/unit/cli-semantic.test.ts tools/eval/memoryMetrics.test.ts"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7",
    "typescript": "~5.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.0",
    "@types/react": "^19.0.10",
    "@zelari/core": "2.63.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "react-dom": "^19.2.7",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "council",
    "coding",
    "llm",
    "zelari",
    "anathema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N-THEM-Studio/zelari-code.git"
  },
  "bugs": {
    "url": "https://github.com/N-THEM-Studio/zelari-code/issues"
  },
  "homepage": "https://anathema-studio.com/zelari-code"
}
