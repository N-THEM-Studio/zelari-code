node_modules/
dist/
*.log
.DS_Store
coverage/
.vitest/
*.tsbuildinfo
packages/*/dist/

# Desktop (Tauri) — keep apps/desktop source, ignore build artifacts
apps/desktop/node_modules/
apps/desktop/dist/
apps/desktop/src-tauri/target/

# Android companion
apps/companion-android/local.properties
apps/companion-android/.gradle/
apps/companion-android/**/build/
apps/companion-android/.idea/
apps/companion-android/*.iml
apps/companion-android/captures/

# VS Code extension (ACP PoC, apps/vscode) — source is committed, the
# compiled adapter (`npm run vscode:build` -> apps/vscode/out) is not.
apps/vscode/out/

# Hermes local agent state (plans, audit reports, session logs)
.hermes/

# Council workspace (v3-W): project-local. Plan state (ledger, task specs,
# plan docs) is tracked so development can continue from another machine;
# runtime state (sessions, memory, radio, worktrees, tmp) stays local.
.zelari/*
!.zelari/plan.json
!.zelari/plan-tasks
!.zelari/docs
# Local MCP server clones/installs (v0.7.9): per-machine, NOT committed
/mcps/
# Local-only scratchpad for git commit message drafts (a session-cwd
# trash bin — never intended to leave the machine). Add the directory
# itself; individual .git-commit-*.txt files were moved into it.
/.git-msg-trash/

# ZCode agent session workspace (per-machine, NOT committed)
.zcode/

# Local scratch (release notes, one-off bump scripts) — never committed
.tmp/

# Eval result store (runtime output of tools/eval regression gate)
eval/results/
packages/core/.zelari/
