{
  // Type-checks the TESTS too (the build config excludes them). Vitest runs
  // them as ESM, hence the module/moduleResolution override; `noEmit` keeps
  // this config from duplicating the build output.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
